{
  // Despliegue en Cloudflare (Workers con ficheros estáticos).
  "name": "antesdevotar",
  "compatibility_date": "2025-09-01",
  "build": { "command": "node build/build.mjs" },
  "assets": {
    "directory": "./dist/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "workers_dev": true,
  "preview_urls": true
}
